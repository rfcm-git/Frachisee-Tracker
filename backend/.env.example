# Copy to backend/.env and fill in. Never commit the real .env.

# Port the API listens on.
PORT=4000

# Supabase project the API reads and writes.
SUPABASE_URL=https://your-project.supabase.co
# The project's SECRET key (Supabase → Project Settings → API Keys → Secret keys). Only the API holds it.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Signs login sessions. Any long random text (at least 32 characters); changing it signs everyone out.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-with-a-long-random-value

# How long a login lasts, in hours.
SESSION_HOURS=12

# First admin account: while no accounts exist, signing in with this username and password creates it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Comma-separated browser origins allowed to call the API (the frontend's address).
CORS_ORIGINS=http://localhost:5173

# Largest JSON request body accepted (imports and restores send many rows at once).
JSON_LIMIT=25mb
