# Copy to backend/.env and fill in. Never commit the real .env.

# Port the API listens on.
PORT=4000

# Supabase project the API reads and writes.
SUPABASE_URL=https://your-project.supabase.co
# The project's publishable (anon) key. The API uses it so the database's existing
# row-level security rules keep applying exactly as they did when the browser connected directly.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Password asked before protected actions (imports, restore, bulk updates).
ADMIN_PASSWORD=change-me

# Comma-separated browser origins allowed to call the API (the frontend's address).
CORS_ORIGINS=http://localhost:5173

# Largest JSON request body accepted (imports and restores send many rows at once).
JSON_LIMIT=25mb
